datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id          String          @id @default(uuid())
  githubUser  String          @unique
  name        String?
  projects    Project[]       @relation("Owner")
  joined      ProjectMember[]
}

model Project {
  id          String          @id @default(uuid())
  title       String
  description String
  techStack   String          // Stored as comma-separated: "React, Node, Prisma"
  repoUrl     String
  ownerId     String
  owner       User            @relation("Owner", fields: [ownerId], references: [id])
  members     ProjectMember[]
  createdAt   DateTime        @default(now())
}

model ProjectMember {
  id        String   @id @default(uuid())
  userId    String
  projectId String
  role      String   // e.g. "Frontend Contributor"
  user      User     @relation(fields: [userId], references: [id])
  project   Project  @relation(fields: [projectId], references: [id])
}